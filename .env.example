# Copy this file to .env and fill in values you need.

# --- LLM (choose one path) ---
# Option A: OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Option B: Local Ollama (used automatically when OPENAI_API_KEY is empty)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# --- Embeddings ---
# Local sentence-transformers model (downloaded on first run)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- RAG settings ---
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K=4

# --- Paths (optional overrides) ---
KNOWLEDGE_BASE_DIR=knowledge_base
CHROMA_DIR=data/chroma
COLLECTION_NAME=cx_knowledge